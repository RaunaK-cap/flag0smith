# Agent server
PORT=4000
# LLM: set ONE of these. Gemini is free: https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional, defaults to gemini-3.5-flash (Gemini) or gpt-5.1 (OpenAI). Also works: gemini-4-hydrogen
MODEL=

# Flagsmith (demo mode uses these)
FLAGSMITH_API_URL=https://api.flagsmith.com/api/v1
FLAGSMITH_ADMIN_TOKEN=
FLAGSMITH_PROJECT_ID=
FLAGSMITH_ENVIRONMENT_ID=
FLAGSMITH_ENVIRONMENT_KEY=
FLAGSMITH_SERVER_KEY=

# GitHub (demo mode: the cloudnote-demo repo)
GITHUB_TOKEN=
GITHUB_REPO=owner/cloudnote-demo

# Optional: Flagsmith webhook secret
FLAGSMITH_WEBHOOK_SECRET=
